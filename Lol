-- FIRE RATE
local FR_GunExceptions={["Sniper"]=true,["Crossbow"]=true,["Bow"]=true,["RPG"]=true}
local FR_Items=nil
pcall(function() FR_Items=require(RS.Modules.ItemLibrary).Items end)
local FR_Orig={} local FR_Loop=nil local FR_Gen=0
local function frBoostPass()
    if KILLED or not FR_Items then return end
    for name,data in pairs(FR_Items) do if type(data)=="table" then
        if not FR_Orig[data] then
            local sn={}
            for _,p in ipairs({"ShootSpread","ShootAccuracy","ShootRecoil","ShootCooldown","ShootBurstCooldown","AttackCooldown","SwingCooldown","MeleeCooldown","Cooldown","RecoveryTime","ResetTime"}) do sn[p]=rawget(data,p) end
            FR_Orig[data]=sn
        end
        if not FR_GunExceptions[name] then
            if data.ShootSpread~=nil then rawset(data,"ShootSpread",0) end
            if data.ShootAccuracy~=nil then rawset(data,"ShootAccuracy",0) end
            if data.ShootRecoil~=nil then rawset(data,"ShootRecoil",0) end
            if data.ShootCooldown~=nil then rawset(data,"ShootCooldown",S.fireRateValue) end
            if data.ShootBurstCooldown~=nil then rawset(data,"ShootBurstCooldown",S.fireRateValue) end
        end
        if data.AttackCooldown~=nil then rawset(data,"AttackCooldown",S.fireRateValue) end
        if data.SwingCooldown~=nil then rawset(data,"SwingCooldown",S.fireRateValue) end
        if data.MeleeCooldown~=nil then rawset(data,"MeleeCooldown",S.fireRateValue) end
        if data.Cooldown~=nil then rawset(data,"Cooldown",S.fireRateValue) end
        if data.RecoveryTime~=nil then rawset(data,"RecoveryTime",S.fireRateValue) end
        if data.ResetTime~=nil then rawset(data,"ResetTime",S.fireRateValue) end
    end end
end
local function frRestorePass()
    if not FR_Items then return end
    for item,sn in pairs(FR_Orig) do
        for p,v in pairs(sn) do
            if rawget(item,p)~=v then rawset(item,p,v) end
        end
    end
end
local function startFR()
    if not FR_Items or KILLED then S.fireRate=false return end
    FR_Gen=FR_Gen+1 local g=FR_Gen
    pcall(frBoostPass)
    if FR_Loop then pcall(task.cancel,FR_Loop) FR_Loop=nil end
    FR_Loop=task.spawn(function()
        while S.fireRate and FR_Gen==g and not KILLED do
            pcall(frBoostPass)
            task.wait(0.25)
        end
    end)
end
local function stopFR()
    S.fireRate=false FR_Gen=FR_Gen+1
    if FR_Loop then pcall(task.cancel,FR_Loop) FR_Loop=nil end
    pcall(frRestorePass) FR_Orig={}
end

-- INF DOUBLE JUMP
local MAX_DJ=676767
local FC_Module,CurFighter,ItemConn
local OrigVals={} local DJLoop=nil local DJGen=0
local function getCtrl()
    if FC_Module then return FC_Module end
    local ps=LP:FindFirstChild("PlayerScripts")
    local ctr=ps and ps:FindFirstChild("Controllers")
    local m=ctr and ctr:FindFirstChild("FighterController")
    if not m then return nil end
    local ok,r=pcall(require,m)
    if ok and type(r)=="table" then FC_Module=r return r end
    return nil
end
local function getFighter()
    local c=getCtrl() if not c then return nil end
    if c.LocalFighter then return c.LocalFighter end
    if type(c.GetFighter)~="function" then return nil end
    local f=c:GetFighter(LP) if f then return f end
    if LP.Character then f=c:GetFighter(LP.Character) if f then return f end end
    return nil
end
local function rememberOrig(item)
    if type(item)~="table" or type(item.Info)~="table" then return end
    if OrigVals[item]==nil then OrigVals[item]=rawget(item.Info,"MaxDoubleJumps") end
end
local function boostItem(item)
    if type(item)~="table" or type(item.Info)~="table" then return end
    rememberOrig(item)
    if rawget(item.Info,"MaxDoubleJumps")~=MAX_DJ then rawset(item.Info,"MaxDoubleJumps",MAX_DJ) end
end
local function restoreItem(item)
    if type(item)~="table" or type(item.Info)~="table" then return end
    local orig=OrigVals[item]
    if orig==nil then
        if rawget(item.Info,"MaxDoubleJumps")~=nil then rawset(item.Info,"MaxDoubleJumps",nil) end
    else
        if rawget(item.Info,"MaxDoubleJumps")~=orig then rawset(item.Info,"MaxDoubleJumps",orig) end
    end
end
local function startDJ()
    if KILLED then return end
    DJGen=DJGen+1 local myGen=DJGen
    if DJLoop then pcall(task.cancel,DJLoop) DJLoop=nil end
    DJLoop=task.spawn(function()
        while S.infDoubleJump and DJGen==myGen and not KILLED do
            pcall(function()
                local f=getFighter()
                if f then
                    if f~=CurFighter then
                        if ItemConn then pcall(function() ItemConn:Disconnect() end) ItemConn=nil end
                        CurFighter=f
                        if f.ItemAdded and type(f.ItemAdded.Connect)=="function" then
                            ItemConn=f.ItemAdded:Connect(function(item) if S.infDoubleJump then boostItem(item) end end)
                        end
                    end
                    if type(f.Items)=="table" then
                        for _,item in pairs(f.Items) do boostItem(item) end
                    end
                end
            end)
            task.wait(0.25)
        end
    end)
end
local function stopDJ()
    S.infDoubleJump=false DJGen=DJGen+1
    if DJLoop then pcall(task.cancel,DJLoop) DJLoop=nil end
    if ItemConn then pcall(function() ItemConn:Disconnect() end) ItemConn=nil end
    for item in pairs(OrigVals) do pcall(restoreItem,item) end
    OrigVals={} CurFighter=nil
end

-- FLY
local savedHS=16 local savedJP=50 local flyConn
local function startFly()
    if S.fly or KILLED then return end
    local h,r=gH(),gr() if not h or not r then return end
    S.fly=true savedHS=h.WalkSpeed savedJP=h.JumpPower
    h.PlatformStand=false h.AutoRotate=false
    FV=Instance.new("BodyVelocity") FV.MaxForce=Vector3.new(1e7,1e7,1e7) FV.Velocity=Vector3.zero FV.Parent=r
    FG=Instance.new("BodyGyro") FG.MaxTorque=Vector3.new(1e7,1e7,1e7) FG.CFrame=r.CFrame FG.Parent=r
    FC=0
    flyConn=R.Heartbeat:Connect(function(dt)
        if not S.fly or not FV or not FG or KILLED then return end
        FC+=dt
        if FC<0.033 then return end
        FC=0
        local d=Vector3.zero
        if U:IsKeyDown(Enum.KeyCode.W) then d+=Cam.CFrame.LookVector end
        if U:IsKeyDown(Enum.KeyCode.S) then d-=Cam.CFrame.LookVector end
        if U:IsKeyDown(Enum.KeyCode.A) then d-=Cam.CFrame.RightVector end
        if U:IsKeyDown(Enum.KeyCode.D) then d+=Cam.CFrame.RightVector end
        if U:IsKeyDown(Enum.KeyCode.Space) then d+=Vector3.yAxis end
        if d.Magnitude>0 then d=d.Unit end
        FV.Velocity=d*S.flySpeed
        FG.CFrame=Cam.CFrame
    end)
    track(flyConn)
end
local function stopFly()
    if not S.fly then return end
    S.fly=false
    if flyConn then flyConn:Disconnect() flyConn=nil end
    if FV then FV:Destroy() FV=nil end
    if FG then FG:Destroy() FG=nil end
    local h=gH()
    if h then
        h.PlatformStand=false h.AutoRotate=true
        h.WalkSpeed=S.walkSpeed and S.walkSpeedValue or savedHS
        h.JumpPower=S.jumpBoost and S.jumpBoostValue or savedJP
    end
end

