local unloading=false
local function unloadScript()
    if unloading then return end
    unloading=true
    KILLED=true
    S.aim=false S.target=nil S.walkSpeed=false S.jumpBoost=false
    S.infJump=false S.noclip=false S.fly=false
    S.esp=false S.names=false S.tracers=false
    S.infDoubleJump=false S.fireRate=false
    pcall(stopDJ) pcall(stopFR) pcall(stopFly) pcall(eoff) pcall(noff)
    pcall(function()
        local h=gH()
        if h then
            h.PlatformStand=false
            h.AutoRotate=true
            pcall(function() h.WalkSpeed=16 end)
            pcall(function() h.JumpPower=50 end)
        end
        local c=LP.Character
        if c then
            for _,p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide=true end
            end
        end
    end)
    for _,l in pairs(lines) do pcall(function() l:Remove() end) end
    lines={}
    for _,c in ipairs(CONNS) do pcall(function() c:Disconnect() end) end
    CONNS={}
    if fovGui then pcall(function() fovGui:Destroy() end) fovGui=nil fovRing=nil end
    for _,p in ipairs(P:GetPlayers()) do
        if p.Character then
            for _,d in ipairs(p.Character:GetDescendants()) do
                if d.Name=="FroggyESP" or d.Name=="FroggyName" then pcall(function() d:Destroy() end) end
            end
        end
    end
    mf.Visible=false
    circleBtn.Visible=false
    pcall(function() gui:Destroy() end)
end
