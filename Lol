-- SILENT AIM
local rayParams=RaycastParams.new()
rayParams.FilterType=Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater=true

local function hasLOS(targetPos, targetModel)
    rayParams.FilterDescendantsInstances={LP.Character,Cam}
    local origin=Cam.CFrame.Position
    local dir=targetPos-origin
    if dir.Magnitude<1 then return false end
    local hit=workspace:Raycast(origin,dir,rayParams)
    if hit==nil then return true end
    if targetModel and hit.Instance:IsDescendantOf(targetModel) then return true end
    if hit.Instance.Transparency>0.9 then return true end
    return false
end

local npcCache = {}
local lastNPCCacheBuild = 0

local function buildNPCCache()
    local now = os.clock()
    if now - lastNPCCacheBuild < NPC_SCAN_INTERVAL then return end
    lastNPCCacheBuild = now
    local newList = {}
    local count = 0
    for _,obj in ipairs(workspace:GetDescendants()) do
        if count >= NPC_MAX_CANDIDATES then break end
        if obj:IsA("Model") and obj ~= LP.Character then
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if not obj:FindFirstChild("PlayerGui") and not P:FindFirstChild(obj.Name) then
                    count = count + 1
                    newList[count] = obj
                end
            end
        end
    end
    npcCache = newList
end

local function findTarget()
    local center = Cam.ViewportSize / 2
    local best, bestDist = nil, math.huge
    local camPos = Cam.CFrame.Position
    local fovRadius = S.fov

    if S.mode == "Player" then
        -- Player mode: NO LOS check. Players behind walls still get targeted.
        for _,p in ipairs(P:GetPlayers()) do
            if p ~= LP then
                local char = p.Character
                if char then
                    local h = char:FindFirstChildOfClass("Humanoid")
                    local b = gp(char, S.part)
                    if h and b and h.Health > 0 then
                        if not (p.Team and LP.Team and p.Team == LP.Team) then
                            local worldDist = (b.Position - camPos).Magnitude
                            if worldDist <= 1000 then
                                local sp, on = Cam:WorldToViewportPoint(b.Position)
                                if on then
                                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                    if d <= fovRadius and d < bestDist then
                                        bestDist = d
                                        best = { position = b.Position, part = b, model = char }
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    else
        -- NPC mode: LOS required. Walls block NPC targeting.
        buildNPCCache()
        for i = 1, #npcCache do
            local m = npcCache[i]
            if m.Parent then
                local b = gp(m, S.part)
                if b then
                    local worldDist = (b.Position - camPos).Magnitude
                    if worldDist <= 1000 then
                        local sp, on = Cam:WorldToViewportPoint(b.Position)
                        if on then
                            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if d <= fovRadius and d < bestDist then
                                if hasLOS(b.Position, m) then
                                    bestDist = d
                                    best = { position = b.Position, part = b, model = m }
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local origIndex_cam = nil
local function installCamHook()
    if origIndex_cam or KILLED or not hookmetamethod then return end
    local isCaller = checkcaller or function() return false end
    origIndex_cam = hookmetamethod(game, "__index", newcclosure(function(self, idx)
        if KILLED then return origIndex_cam(self, idx) end
        if self == Cam and idx == "ViewportSize" and S.aim and not isCaller() and S.target then
            local sp, on = Cam:WorldToViewportPoint(S.target)
            if on then return Vector2.new(sp.X * 2, sp.Y * 2) end
        end
        return origIndex_cam(self, idx)
    end))
end
