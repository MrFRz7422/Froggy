-- HUMANOID HOOK
local origIndex_h=nil local origNewIndex_h=nil
local function installHumanoidHook()
    if KILLED or not getrawmetatable or not hookmetamethod then return end
    local hum=gH() if not hum then return end
    local ok,mt=pcall(getrawmetatable,hum) if not ok or not mt then return end
    if not origIndex_h then origIndex_h=rawget(mt,"__index") end
    if not origNewIndex_h then origNewIndex_h=rawget(mt,"__newindex") end
    local newIndex=newcclosure(function(self,idx)
        if not KILLED and typeof(self)=="Instance" and self:IsA("Humanoid") then
            if idx=="WalkSpeed" and S.walkSpeed then return S.walkSpeedValue end
            if idx=="JumpPower" and S.jumpBoost then return S.jumpBoostValue end
        end
        return origIndex_h(self,idx)
    end)
    local newNewIndex=newcclosure(function(self,idx,val)
        if not KILLED and typeof(self)=="Instance" and self:IsA("Humanoid") then
            if idx=="WalkSpeed" and S.walkSpeed then return origNewIndex_h(self,idx,S.walkSpeedValue) end
            if idx=="JumpPower" and S.jumpBoost then return origNewIndex_h(self,idx,S.jumpBoostValue) end
        end
        return origNewIndex_h(self,idx,val)
    end)
    pcall(function()
        if setreadonly then setreadonly(mt,false) end
        mt.__index=newIndex mt.__newindex=newNewIndex
        if setreadonly then setreadonly(mt,true) end
    end)
end
