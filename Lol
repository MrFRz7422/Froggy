-- DRAG SYSTEM — works on ANY descendant of mf except interactive controls
local dragging=false
local dragInput=nil
local dragStart=nil
local dragStartPos=nil

local function tryStartDrag(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        dragging=true
        dragInput=i
        dragStart=i.Position
        dragStartPos=mf.Position
    end
end

-- Attach drag start to every non-interactive descendant
local function attachDrag(obj)
    if obj:IsA("TextButton") or obj:IsA("ImageButton") or obj:IsA("TextBox") then
        -- Buttons/textboxes: still start drag, but let their click handlers fire
        obj.InputBegan:Connect(tryStartDrag)
        return
    end
    if obj:IsA("Frame") or obj:IsA("TextLabel") or obj:IsA("ImageLabel") or obj:IsA("CanvasGroup") or obj:IsA("ScrollingFrame") then
        obj.InputBegan:Connect(tryStartDrag)
    end
end

attachDrag(mf)

U.InputChanged:Connect(function(i)
    if not dragging or i~=dragInput then return end
    if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
        local d=i.Position-dragStart
        mf.Position=UDim2.new(dragStartPos.X.Scale,dragStartPos.X.Offset+d.X,dragStartPos.Y.Scale,dragStartPos.Y.Offset+d.Y)
    end
end)
U.InputEnded:Connect(function(i)
    if i==dragInput then dragging=false dragInput=nil end
end)

local function clampPanel()
    local vp = Cam.ViewportSize
    local abs = mf.AbsoluteSize
    if abs.X <= 0 or abs.Y <= 0 then return end
    local sx, sy = mf.Position.X.Scale, mf.Position.Y.Scale
    local ox, oy = mf.Position.X.Offset, mf.Position.Y.Offset
    local px = sx * vp.X + ox - abs.X * 0.5
    local py = sy * vp.Y + oy - abs.Y * 0.5
    px = math.clamp(px, 0, math.max(0, vp.X - abs.X))
    py = math.clamp(py, 0, math.max(0, vp.Y - abs.Y))
    mf.Position = UDim2.fromOffset(px + abs.X * 0.5, py + abs.Y * 0.5)
end

